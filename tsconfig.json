{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "esModuleInterop": true,
    "declaration": true, "outDir": "./dist", "strict": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "resolveJsonModule": true, "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"], "exclude": ["node_modules", "dist"]
}
